{
  "name": "orders-console",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm -w @oc/api run dev\" \"npm -w @oc/web run dev\"",
    "seed": "npm -w @oc/api run seed",
    "prove:idempotency": "npm -w @oc/api run prove:idempotency",
    "test": "npm -w @oc/api test",
    "typecheck": "npm -ws --if-present run typecheck",
    "build": "npm -w @oc/web run build",
    "db:up": "docker compose up -d mongo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
