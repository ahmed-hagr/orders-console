# Copy to apps/api/.env  (cp .env.example apps/api/.env)
MONGO_URI=mongodb://127.0.0.1:27017/orders_console
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_TTL=8h
PORT=4000
# Artificial delay for GET /api/orders/stats (brief O1 asks for 3-6 s)
STATS_DELAY_MIN_MS=3000
STATS_DELAY_MAX_MS=6000
# 0..1 share of stats calls that fail with 503, to demo the error + retry state
STATS_FAIL_RATE=0
